# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Server Configuration
NODE_ENV=production
PORT=9600

# Database Configuration (Update with DigitalOcean managed database URLs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/confetti
POSTGRES_URI=postgresql://username:password@host:port/confetti
REDIS_URL=rediss://username:password@host:port
REDIS_HOST=your-redis-host
REDIS_PORT=25061

# API URLs
PYTHON_API_URL=http://python-api:5600

# Frontend URL (Update with your domain)
FRONTEND_URL=https://your-domain.com

# Public URLs (Update with your domain)
PUBLIC_NGROK_URL=https://your-domain.com

# JWT Configuration (GENERATE NEW SECRETS!)
JWT_ACCESS_SECRET=your-super-secure-jwt-access-secret-here-change-this-in-production
JWT_REFRESH_SECRET=your-super-secure-jwt-refresh-secret-here-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Social Authentication (Update with production keys)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback
GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key

# Facebook OAuth (Update with production keys)
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=your-production-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback

# Twitter API (Update with production keys)
TWITTER_CONSUMER_KEY=your-production-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-production-twitter-consumer-secret
TWITTER_CALLBACK_URL=https://your-domain.com/api/auth/twitter/callback

# Session Secret (GENERATE NEW SECRET!)
SESSION_SECRET=your-super-secure-session-secret-here-change-this-in-production

# Email Configuration (Update with production SMTP)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-production-email@yourdomain.com
SMTP_PASSWORD=your-production-email-password
SMTP_FROM=your-production-email@yourdomain.com
FROM_EMAIL=your-production-email@yourdomain.com
FROM_NAME=Confetti Team
SUPPORT_EMAIL=support@yourdomain.com

# OpenAI API for AI recommendations (Update with production key)
OPENAI_API_KEY=your-production-openai-api-key

# Payment Gateway Configuration (Update with production keys)
# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-production-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-production-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-production-encryption-key
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_WEBHOOK_SECRET=your-production-webhook-secret
FLUTTERWAVE_WEBHOOK=https://your-domain.com/api/v1/webhooks/flutterwave

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_your-production-public-key
PAYSTACK_SECRET_KEY=sk_live_your-production-secret-key
PAYSTACK_WEBHOOK_SECRET=your-production-paystack-webhook-secret

# MTN API Configuration (Update with production keys)
MTN_CONSUMER_KEY=your-production-mtn-consumer-key
MTN_CONSUMER_SECRET=your-production-mtn-consumer-secret
MTN_BASE_URL=https://nigeria.api.mtn.com
MTN_OAUTH_URL=https://api.mtn.com/v1/oauth/access_token
MTN_SMS_ENDPOINT=/v1/sms/send
MTN_CALLBACK_URL=https://your-domain.com/api/phone/mtn-callback

# Cloudinary Configuration (Update with production keys)
CLOUDINARY_CLOUD_NAME=your-production-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-production-cloudinary-api-key
CLOUDINARY_API_SECRET=your-production-cloudinary-api-secret

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# Admin Configuration (Update with secure credentials)
ADMIN_USER=admin@yourdomain.com
ADMIN_PASSWORD=your-super-secure-admin-password

# Additional Production Settings
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
LOG_LEVEL=info
MAX_FILE_SIZE=50mb
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100